generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                 Int        @id @default(autoincrement())
  name               String
  domain             String     @unique(map: "sqlite_autoindex_companies_1")
  linkedinCompanyUrl String     @unique(map: "sqlite_autoindex_companies_2") @map("linkedin_company_url")
  websiteUrl         String?    @map("website_url")
  description        String?
  industry           String?
  location           String?
  employeeCount      Int?       @map("employee_count")
  employeeCountRange String?    @map("employee_count_range")
  dateEnriched       String?    @map("date_enriched")
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")
  positions          Position[]

  @@map("companies")
}

model Person {
  id                 Int        @id @default(autoincrement())
  profileKey         String     @unique(map: "sqlite_autoindex_people_1") @map("profile_key")
  linkedinProfileUrl String?    @unique(map: "people_linkedin_profile_url_idx") @map("linkedin_profile_url")
  quickmailLeadId    String?    @unique(map: "people_quickmail_lead_id_idx") @map("quickmail_lead_id")
  name               String
  email              String?
  phoneNumber        String?    @map("phone_number")
  status             String     @default("New")
  qualified          Boolean    @default(false)
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")
  positions          Position[]

  @@map("people")
}

model Position {
  id         Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  personId  Int      @map("person_id")
  title      String?
  department String?
  seniority  String?
  startDate  String?  @map("start_date")
  endDate    String?  @map("end_date")
  isCurrent  Boolean  @default(true) @map("is_current")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // positions_unique_role_idx is a SQLite expression unique index managed by
  // migration 002_restore_database_guards so NULL title/startDate values are
  // treated like empty strings for duplicate detection.
  @@index([personId], map: "positions_person_id_idx")
  @@index([companyId], map: "positions_company_id_idx")
  @@map("positions")
}
